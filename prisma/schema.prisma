generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  name          String
  email         String          @unique
  password      String
  totalPoints   Int
  createdAt     DateTime        @default(now())
  idUser        Int             @id @default(autoincrement())
  learnings     Learning[]
  microCourses  MicroCourse[]
  rewardHistory RewardHistory[]
}

model MicroCourse {
  title         String
  description   String?
  createdAt     DateTime   @default(now())
  creatorId     Int
  idMicroCourse Int        @id @default(autoincrement())
  learnings     Learning[]
  creator       User       @relation(fields: [creatorId], references: [idUser])
}

model Learning {
  idLearning    Int         @id @default(autoincrement())
  userId        Int
  microCourseId Int
  startDate     DateTime    @default(now())
  status        String
  microCourse   MicroCourse @relation(fields: [microCourseId], references: [idMicroCourse])
  user          User        @relation(fields: [userId], references: [idUser])
}

model RewardHistory {
  idHistory  Int      @id @default(autoincrement())
  userId     Int
  rewardId   Int
  obtainedAt DateTime @default(now())
  reward     Reward   @relation(fields: [rewardId], references: [idReward])
  user       User     @relation(fields: [userId], references: [idUser])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model Reward {
  idReward          Int             @id @default(autoincrement())
  name              String
  description       String?
  requiredPoints    Int
  availableQuantity Int?
  rewardHistory     RewardHistory[]
}
