generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  name          String
  email         String          @unique
  password      String
  totalPoints   Int
  createdAt     DateTime        @default(now())
  idUser        Int             @id @default(autoincrement())
  microCourses  MicroCourse[]
  MyLearning    MyLearning[]
  rewardHistory RewardHistory[]
}

model MicroCourse {
  title         String
  description   String?
  createdAt     DateTime     @default(now())
  creatorId     Int
  idMicroCourse Int          @id @default(autoincrement())
  creator       User         @relation(fields: [creatorId], references: [idUser])
  MyLearning    MyLearning[]

  @@index([creatorId])
}

model RewardHistory {
  idHistory  Int      @id @default(autoincrement())
  userId     Int
  rewardId   Int
  obtainedAt DateTime @default(now())
  reward     Reward   @relation(fields: [rewardId], references: [idReward])
  user       User     @relation(fields: [userId], references: [idUser])

  @@index([rewardId])
  @@index([userId])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model Reward {
  idReward          Int             @id @default(autoincrement())
  name              String
  description       String?
  requiredPoints    Int
  availableQuantity Int?
  rewardHistory     RewardHistory[]
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model MyLearning {
  idMyLearning  Int         @id(map: "Learning_pkey") @default(autoincrement())
  userId        Int
  microCourseId Int
  startDate     DateTime    @default(now())
  status        String
  MicroCourse   MicroCourse @relation(fields: [microCourseId], references: [idMicroCourse], map: "Learning_microCourseId_fkey")
  User          User        @relation(fields: [userId], references: [idUser], map: "Learning_userId_fkey")

  @@index([microCourseId])
  @@index([userId])
}
