generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model MicroCourse {
  id            BigInt  @id @unique(map: "id") @default(autoincrement()) @db.UnsignedBigInt
  idMicroCourse Int?
  title         String? @db.Text

}

model User {
  id          Int    @id @default(autoincrement())
  name        String
  email       String @unique
  password    String
  totalPoints Int    @default(0)
}
